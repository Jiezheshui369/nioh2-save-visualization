{
  "name": "nioh2-save-companion",
  "version": "0.7.16-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:android": "tsc -b && vite build --config vite.config.ts --mode android && node scripts/prepare-android.mjs",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "ios:sync": "npm run build:android && cap sync ios",
    "ios:open": "cap open ios",
    "handoff:check": "python scripts/prepare_handoff.py --check"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "8.0.2",
    "lucide-react": "^1.46.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^25.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
